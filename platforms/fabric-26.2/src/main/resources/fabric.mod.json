{
  "schemaVersion": 1,
  "id": "cipherchannels",
  "version": "${version}",
  "name": "CipherChannels",
  "description": "Encrypted Minecraft chat with shared secret invites. No server plugin needed.",
  "authors": ["CipherChannels contributors"],
  "license": "All Rights Reserved",
  "icon": "assets/cipherchannels/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.cipherchannels.CipherChannelsClient"],
    "modmenu": ["dev.cipherchannels.ui.ModMenuIntegration"]
  },
  "mixins": ["cipherchannels.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {"modmenu": "*"}
}
